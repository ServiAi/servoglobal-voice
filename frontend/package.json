{
  "name": "landing-serviglobalai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run clean:next && next dev",
    "dev:clean": "npm run clean:next && next dev",
    "dev:turbo": "npm run clean:next && next dev --turbo",
    "build": "next build",
    "build:check": "npm run clean:next && next build && npm run clean:next",
    "clean:next": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "start": "next start",
    "lint": "next lint",
    "qa:auth": "playwright test --project=auth --headed",
    "qa:visual": "playwright test --project=crm-visual",
    "qa:public": "node ./tests/support/run-public-qa.mjs",
    "qa:visual:update": "playwright test --project=crm-visual --update-snapshots",
    "qa:report": "playwright show-report"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@marsidev/react-turnstile": "^1.4.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/three": "^0.160.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^10.18.0",
    "gsap": "^3.12.0",
    "lucide-react": "^0.300.0",
    "maath": "^0.10.8",
    "next": "^15.1.0",
    "next-intl": "^4.7.0",
    "next-themes": "^0.4.6",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.1",
    "schema-dts": "^1.1.5",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.160.0",
    "ultravox-client": "^0.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8",
    "tailwindcss": "^4.1.18",
    "typescript": "^5"
  }
}
