{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "postgres": {
      "type": "local",
      "enabled": true,
      "timeout": 120000,
      "command": ["uv", "run", "postgres-mcp", "--access-mode=unrestricted"],
      "environment": {
        "DATABASE_URI": "{env:DATABASE_URI}",
      },
    },

    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}",
      },
    },

    "codegraph": {
      "type": "local",
      "enabled": true,
      "timeout": 120000,
      "command": ["codegraph", "serve", "--mcp"],
    },

    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "timeout": 120000,
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
    },

    "dokploy-mcp": {
      "type": "local",
      "enabled": true,
      "timeout": 120000,
      "command": ["cmd", "/c", "npx", "-y", "@dokploy/mcp@latest"],
      "environment": {
        "DOKPLOY_URL": "{env:DOKPLOY_URL}",
        "DOKPLOY_API_KEY": "{env:DOKPLOY_API_KEY}",
      },
    },
    "auth0": {
      "type": "local",
      "enabled": true,
      "timeout": 120000,
      "command": ["cmd", "/c", "npx", "-y", "@auth0/auth0-mcp-server", "run"],
      "environment": {
        "DEBUG": "auth0-mcp",
      },
    },
  },

  "provider": {
    "nan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NaN",
      "options": {
        "baseURL": "https://api.nan.builders/v1",
        "apiKey": "{env:NAN_API_KEY}",
      },
      "models": {
        "qwen3.6": {
          "name": "Qwen 3.6",
        },
        "gemma4": {
          "name": "Gemma 4",
          "contextWindow": 262144,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "contextWindow": 500000,
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "mimo-v2.5": {
          "name": "Xiaomi MiMo V2.5",
          "contextWindow": 500000,
          "modalities": {
            "input": ["text", "image", "audio"],
            "output": ["text"],
          },
        },
      },
    },
  },
}
