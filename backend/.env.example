ULTRAVOX_API_KEY=your_ultravox_api_key_here
ULTRAVOX_MODEL=fixie-ai/ultravox-70b
ULTRAVOX_WEBHOOK_SECRET=your_ultravox_webhook_secret_here
ULTRAVOX_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=60
ULTRAVOX_ALLOW_UNSIGNED_WEBHOOKS=false
PORT=8000
DEFAULT_AGENT_ID=your_default_agent_id_here
DATABASE_URL=postgresql+psycopg://serviai:serviai@localhost:5432/serviai

# Auth0 / private dashboard base (staging)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_ISSUER=
AUTH0_ALGORITHMS=RS256
AUTH0_AUTO_CREATE_USERS=true
AUTH0_MANAGEMENT_DOMAIN=
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
AUTH0_MANAGEMENT_AUDIENCE=https://your-auth0-domain/api/v2/
AUTH0_ONBOARDING_CONNECTION=Username-Password-Authentication
AUTH0_ONBOARDING_APP_CLIENT_ID=
AUTH0_ONBOARDING_SEND_VERIFICATION_EMAIL=true
AUTH0_ONBOARDING_TRIGGER_PASSWORD_RESET=true
AUTH0_ONBOARDING_ALLOW_AUTHENTICATION_SIGNUP_FALLBACK=true

# Initial private app bootstrap
BOOTSTRAP_TENANT_NAME=ServiGlobal IA
BOOTSTRAP_TENANT_SLUG=serviglobal-ia
BOOTSTRAP_TENANT_TIMEZONE=America/Bogota
BOOTSTRAP_USER_AUTH0_SUB=auth0|your_initial_user_id
BOOTSTRAP_USER_EMAIL=admin@serviglobal-ia.com
BOOTSTRAP_USER_NAME=ServiGlobal Admin
BOOTSTRAP_USER_ROLE=tenant_admin

ASTERISK_PUBLIC_HOST=your_asterisk_public_host
UVX_SIP_USERNAME=your_uvx_sip_username
UVX_SIP_PASSWORD=your_uvx_sip_password
CAL_API_KEY=your_cal_api_key_here
CAL_EVENT_TYPE_ID=your_cal_event_type_id
CAL_USERNAME=your_cal_username
CAL_TIMEZONE=America/Bogota
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
VOICE_CONTEXT_SESSION_TTL_SECONDS=600
VOICE_PUBLIC_SUBMISSION_RATE_LIMIT_GLOBAL_IP_PER_MINUTE=20
VOICE_PUBLIC_SUBMISSION_RATE_LIMIT_TENANT_IP_PER_MINUTE=5
VOICE_PUBLIC_RATE_LIMIT_HASH_SECRET=
TRUST_CLOUDFLARE_CONNECTING_IP=false

# WhatsApp API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=your_whatsapp_webhook_token

# Chatwoot CRM
CHATWOOT_API_TOKEN=       # Profile → Access Token en crm.serviglobal-ia.com
CHATWOOT_ACCOUNT_ID=1     # Settings → General → Account ID
CHATWOOT_INBOX_ID=1       # Settings → Inboxes → tu inbox WhatsApp → ID en la URL
CALCOM_WEBHOOK_SECRET=your_calcom_webhook_secret_here

# Tenant integrations
INTEGRATIONS_ENCRYPTION_KEY=
EMAIL_ASSETS_STORAGE_PATH=storage/email-assets
EMAIL_MAX_ATTACHMENT_BYTES=10485760
EMAIL_MAX_TOTAL_ATTACHMENTS_BYTES=15728640
